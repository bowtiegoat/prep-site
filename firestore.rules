rules_version = '2';

// Students never write directly; their sign-ups, event changes, and exam
// submissions go through Cloud Functions. Answer keys are admin-only.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'justin@thebowtiegoat.com'
        && request.auth.token.email_verified == true;
    }

    // Advisors are stored by their lowercase email address.
    function advisorPath() {
      return /databases/$(database)/documents/advisors/$(request.auth.token.email.lower());
    }

    function isAdvisorOf(schoolId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(advisorPath())
        && get(advisorPath()).data.schoolId == schoolId;
    }

    // School names for the sign-up picker (codes live in schoolCodes).
    // Advisors may set their school's competition dates and adjust its prep
    // plan (removed tasks, their own info-only items).
    match /schools/{schoolId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow update: if isAdvisorOf(schoolId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['competitionDates', 'planSettings', 'eventSettings'])
        && (!('eventSettings' in request.resource.data)
          || (request.resource.data.eventSettings is map
            && request.resource.data.eventSettings.keys().hasOnly(['multi', 'max'])
            && request.resource.data.eventSettings.multi is bool
            && request.resource.data.eventSettings.max in [2, 3]))
        && (!('planSettings' in request.resource.data)
          || (request.resource.data.planSettings is map
            && request.resource.data.planSettings.keys().hasOnly(['removed', 'items', 'catchupHandled', 'catchupHandledWritten', 'catchupHandledSelling', 'catchupHandledSbeChapter', 'catchupHandledSbeIndividual'])
            && (!('removed' in request.resource.data.planSettings) || request.resource.data.planSettings.removed.size() <= 150)
            && (!('items' in request.resource.data.planSettings) || request.resource.data.planSettings.items.size() <= 100)));
    }

    // Site-wide settings, e.g. this year's ICDC dates.
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Teams of students, formed by their advisor. Students can see their own
    // teams so their role play logs can be shared with teammates.
    match /teams/{teamId} {
      allow read, delete: if isAdmin() || isAdvisorOf(resource.data.schoolId);
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isAdvisorOf(request.resource.data.schoolId)
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 2
        && request.resource.data.memberUids.size() <= 3;
      // Teammates share one prep plan: they may check off team tasks and
      // share links (outline, drafts, final paper), and nothing else.
      allow update: if signedIn() && request.auth.uid in resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['planChecks', 'planLinks'])
        && (!('planChecks' in request.resource.data)
          || (request.resource.data.planChecks is map && request.resource.data.planChecks.size() <= 200))
        && (!('planLinks' in request.resource.data)
          || (request.resource.data.planLinks is map && request.resource.data.planLinks.size() <= 60));
    }

    // Advisors can see their own school's code to share with students.
    match /schoolCodes/{schoolId} {
      allow read, write: if isAdmin();
      allow read: if isAdvisorOf(schoolId);
    }

    match /advisors/{advisorId} {
      allow read, write: if isAdmin();
      allow read: if signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == advisorId;
      // Advisors can see who else advises their school.
      allow read: if isAdvisorOf(resource.data.schoolId);
    }

    // Role play practice logs. A student writes their own; on a team event the
    // log is shared with the teammates their advisor paired (memberUids must
    // match the team exactly). Any member can edit or delete it. Advisors and
    // the admin can read their school's logs.
    function isUrlOrEmpty(value) {
      return value is string && value.size() <= 1000
        && (value == '' || value.matches('https?://.+'));
    }

    function validLog(d) {
      return d.keys().hasOnly(['memberUids', 'teamId', 'schoolId', 'eventCode', 'rubric', 'date', 'source',
          'goatFile', 'title', 'url', 'ia', 'pis', 'levels', 'score', 'videoUrl', 'judge', 'feedback',
          'fixNext', 'timed', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && d.memberUids is list && d.memberUids.size() >= 1 && d.memberUids.size() <= 3
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.source in ['goat', 'deca']
        && d.rubric in ['series', 'team', 'principles', 'pfl']
        && (d.goatFile == null || (d.goatFile is string && d.goatFile.size() <= 200))
        && d.title is string && d.title.size() <= 200
        && isUrlOrEmpty(d.url) && d.url != ''
        && d.ia is string && d.ia.size() <= 100
        && (d.pis == null || (d.pis is list && d.pis.size() <= 5))
        && d.levels is map && d.levels.size() >= 1 && d.levels.size() <= 12
        && (d.score == null || (d.score is int && d.score >= 0 && d.score <= 100))
        && isUrlOrEmpty(d.videoUrl)
        && d.judge is string && d.judge.size() <= 60
        && d.feedback is string && d.feedback.size() <= 5000
        && (!('fixNext' in d) || (d.fixNext is string && d.fixNext.size() <= 500))
        && (!('timed' in d) || d.timed is bool)
        && d.updatedAt == request.time;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function teamMatches(d) {
      return d.teamId is string
        && get(/databases/$(database)/documents/teams/$(d.teamId)).data.memberUids == d.memberUids;
    }

    // PI flashcard decks: any signed-in student can study them; only the admin uploads.
    match /flashDecks/{deckId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Each student's PI card sessions, missed-PI record, and study days.
    // Students keep their own; advisors see their school's.
    match /cardProgress/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isAdvisorOf(resource.data.schoolId));
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.schoolId == userDoc().schoolId
        && request.resource.data.keys().hasOnly(['schoolId', 'sessions', 'stats', 'studyDays', 'updatedAt'])
        && request.resource.data.sessions is map && request.resource.data.sessions.size() <= 4
        && request.resource.data.stats is map && request.resource.data.stats.size() <= 600
        && request.resource.data.studyDays is map && request.resource.data.studyDays.size() <= 400;
    }

    match /roleplayLogs/{logId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.memberUids
        || isAdmin() || isAdvisorOf(resource.data.schoolId));
      allow create: if signedIn()
        && validLog(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdByName is string && request.resource.data.createdByName.size() <= 120
        && request.resource.data.schoolId == userDoc().schoolId
        && (request.resource.data.eventCode == userDoc().eventCode
          || request.resource.data.eventCode in userDoc().get('extraEvents', []))
        && ((request.resource.data.memberUids == [request.auth.uid] && request.resource.data.teamId == null)
          || (request.auth.uid in request.resource.data.memberUids && teamMatches(request.resource.data)));
      allow update: if signedIn() && request.auth.uid in resource.data.memberUids
        && validLog(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'source', 'goatFile', 'title',
          'url', 'ia', 'pis', 'levels', 'score', 'videoUrl', 'judge', 'feedback', 'fixNext', 'timed', 'rubric', 'updatedAt'])
        && request.resource.data.rubric == resource.data.rubric;
      allow delete: if signedIn() && request.auth.uid in resource.data.memberUids;
    }

    // Exam list (no answers).
    match /exams/{examId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Each question's PI and source, without answers (for the exam deep dive).
    match /examQuestions/{examId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /examKeys/{examId} {
      allow read, write: if isAdmin();
    }

    // Site-wide numbers only: count, total, score distribution. No names.
    match /examStats/{examId} {
      allow read: if signedIn();
    }

    match /users/{uid} {
      // Advisors may excuse prep plan items for their own students, give
      // each member a copy of their team's plan progress when they break up a
      // team, and archive or restore a student's account (e.g. a duplicate).
      allow update: if isAdvisorOf(resource.data.schoolId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['planExcused', 'planLateHandled', 'planLateHandledEvents', 'planChecks', 'planLinks', 'archived', 'archivedAt', 'archivedBy'])
        && (!('archived' in request.resource.data) || request.resource.data.archived is bool)
        && (!('planChecks' in request.resource.data)
          || (request.resource.data.planChecks is map && request.resource.data.planChecks.size() <= 200))
        && (!('planLinks' in request.resource.data)
          || (request.resource.data.planLinks is map && request.resource.data.planLinks.size() <= 60))
        && (!('planExcused' in request.resource.data)
          || (request.resource.data.planExcused is map && request.resource.data.planExcused.size() <= 150))
        && (!('planLateHandledEvents' in request.resource.data)
          || (request.resource.data.planLateHandledEvents is map && request.resource.data.planLateHandledEvents.size() <= 3));
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isAdvisorOf(resource.data.schoolId));
      // Students may only change which attempts are left out of their
      // "All missed questions" table, their last active day, and the
      // checkboxes and links on their prep plan.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['excludedAttempts', 'lastActiveDate', 'planChecks', 'planLinks'])
        && (!('excludedAttempts' in request.resource.data)
          || (request.resource.data.excludedAttempts is list && request.resource.data.excludedAttempts.size() <= 1000))
        && (!('lastActiveDate' in request.resource.data)
          || (request.resource.data.lastActiveDate is string && request.resource.data.lastActiveDate.size() == 10))
        && (!('planChecks' in request.resource.data)
          || (request.resource.data.planChecks is map && request.resource.data.planChecks.size() <= 200))
        && (!('planLinks' in request.resource.data)
          || (request.resource.data.planLinks is map && request.resource.data.planLinks.size() <= 60));
    }

    // resource == null lets a student check whether they've taken an exam yet.
    match /attempts/{attemptId} {
      allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin()
        || isAdvisorOf(resource.data.schoolId));
    }

    match /statsEntries/{entryId} {
      allow read: if isAdmin();
    }

    // Past scores imported from other sites (anonymous), one doc per batch.
    match /statsImports/{batchId} {
      allow read: if isAdmin();
    }

    // Things for the admin to review, e.g. a student who took one exam more
    // than 5 times. Written by the server; the admin marks them reviewed.
    match /flags/{flagId} {
      allow read, update, delete: if isAdmin();
      // Advisors send reports (problems, ideas) from their dashboard and can
      // see the ones they sent, including whether the admin reviewed them.
      allow create: if signedIn()
        && request.resource.data.type == 'advisor-report'
        && isAdvisorOf(request.resource.data.schoolId)
        && request.resource.data.byEmail == request.auth.token.email.lower()
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['type', 'kind', 'area', 'message', 'studentUid', 'studentName', 'byEmail', 'byName', 'schoolId', 'schoolName', 'page', 'userAgent', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && resource.data.type == 'advisor-report'
        && resource.data.byEmail == request.auth.token.email.lower();
    }

    // Copies of attempts deleted by the admin or an advisor.
    match /deletedAttempts/{attemptId} {
      allow read: if isAdmin();
    }
  }
}
